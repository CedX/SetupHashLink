{
	"global": {"numIndentationSpaces": 2},
	"ignoreFiles": ["obj/"],
	"activePatternNames": {"enabled": true, "config": {"naming": "PascalCase", "underscores": "None"}},
	"asyncExceptionWithoutReturn": {"enabled": true},
	"asynchronousFunctionNames": {"enabled": true, "config": {"mode": "OnlyPublicAPIsInLibraries"}},
	"avoidSinglePipeOperator": {"enabled": true},
	"avoidTooShortNames": {"enabled": false},
	"canBeReplacedWithComposition": {"enabled": true},
	"classMemberSpacing": {"enabled": true},
	"cyclomaticComplexity": {"enabled": true, "config": {"maxComplexity": 50}},
	"disallowShadowing": {"enabled": false},
	"discourageStringInterpolationWithStringFormat": {"enabled": true},
	"ensureTailCallDiagnosticsInRecursiveFunctions": {"enabled": true},
	"enumCasesNames": {"enabled": true, "config": {"naming": "PascalCase", "underscores": "None"}},
	"exceptionNames": {"enabled": true, "config": {"naming": "PascalCase", "underscores": "None", "suffix": "Exception"}},
	"failwithBadUsage": {"enabled": true},
	"failwithfWithArgumentsMatchingFormatString": {"enabled": true},
	"failwithWithSingleArgument": {"enabled": true},
	"favourAsKeyword": {"enabled": true},
	"favourConsistentThis": {"enabled": true, "config": {"symbol": "this"}},
	"favourIgnoreOverLetWild": {"enabled": true},
	"favourNamedMembers": {"enabled": true},
	"favourNestedFunctions": {"enabled": true},
	"favourNonMutablePropertyInitialization": {"enabled": true},
	"favourReRaise": {"enabled": true},
	"favourSingleton": {"enabled": true},
	"favourStaticEmptyFields": {"enabled": false},
	"favourTypedIgnore": {"enabled": true},
	"genericTypesNames": {"enabled": true, "config": {"naming": "PascalCase", "underscores": "None"}},
	"indentation": {"enabled": true},
	"indexerAccessorStyleConsistency": {"enabled": true, "config": {"style": "CSharp"}},
	"interfaceNames": {"enabled": true, "config": {"naming": "PascalCase", "underscores": "None", "prefix": "I"}},
	"internalValuesNames": {"enabled": true, "config": {"naming": "CamelCase", "underscores": "AllowPrefix"}},
	"interpolatedStringWithNoSubstitution": {"enabled": true},
	"invalidArgWithTwoArguments": {"enabled": true},
	"invalidOpWithSingleArgument": {"enabled": true},
	"literalNames": {"enabled": true, "config": {"naming": "PascalCase", "underscores": "None"}},
	"maxCharactersOnLine": {"enabled": true, "config": {"maxCharactersOnLine": 160}},
	"maxLinesInClass": {"enabled": true, "config": {"maxLines": 500}},
	"maxLinesInConstructor": {"enabled": true, "config": {"maxLines": 100}},
	"maxLinesInEnum": {"enabled": true, "config": {"maxLines": 500}},
	"maxLinesInFile": {"enabled": true, "config": {"maxLinesInFile": 1000}},
	"maxLinesInFunction": {"enabled": true, "config": {"maxLines": 100}},
	"maxLinesInLambdaFunction": {"enabled": true, "config": {"maxLines": 7}},
	"maxLinesInMatchLambdaFunction": {"enabled": true, "config": {"maxLines": 100}},
	"maxLinesInMember": {"enabled": true, "config": {"maxLines": 100}},
	"maxLinesInModule": {"enabled": true, "config": {"maxLines": 1000}},
	"maxLinesInProperty": {"enabled": true, "config": {"maxLines": 70}},
	"maxLinesInRecord": {"enabled": true, "config": {"maxLines": 500}},
	"maxLinesInUnion": {"enabled": true, "config": {"maxLines": 500}},
	"maxLinesInValue": {"enabled": true, "config": {"maxLines": 100}},
	"maxNumberOfBooleanOperatorsInCondition": {"enabled": true, "config": {"maxItems": 4}},
	"maxNumberOfFunctionParameters": {"enabled": true, "config": {"maxItems": 5}},
	"maxNumberOfItemsInTuple": {"enabled": true, "config": {"maxItems": 4}},
	"maxNumberOfMembers": {"enabled": true, "config": {"maxItems": 50}},
	"measureTypeNames": {"enabled": true, "config": {"underscores": "None"}},
	"memberNames": {"enabled": true, "config": {"naming": "PascalCase", "underscores": "AllowPrefix"}},
	"moduleDeclSpacing": {"enabled": false},
	"moduleNames": {"enabled": true, "config": {"naming": "PascalCase", "underscores": "None"}},
	"namespaceNames": {"enabled": true, "config": {"naming": "PascalCase", "underscores": "None"}},
	"nestedFunctionNames": {"enabled": true, "config": {"naming": "CamelCase", "underscores": "None"}},
	"nestedStatements": {"enabled": true, "config": {"depth": 8}},
	"noAsyncRunSynchronouslyInLibrary": {"enabled": true},
	"noPartialFunctions": {"enabled": false},
	"noTabCharacters": {"enabled": true},
	"nullArgWithSingleArgument": {"enabled": true},
	"parameterNames": {"enabled": true, "config": {"naming": "CamelCase", "underscores": "AllowPrefix"}},
	"patternMatchClauseIndentation": {"enabled": true},
	"patternMatchClausesOnNewLine": {"enabled": false},
	"patternMatchExpressionIndentation": {"enabled": true},
	"patternMatchOrClausesOnNewLine": {"enabled": true},
	"privateValuesNames": {"enabled": true, "config": {"naming": "CamelCase", "underscores": "AllowPrefix"}},
	"publicValuesNames": {"enabled": true, "config": {"underscores": "AllowPrefix"}},
	"raiseWithSingleArgument": {"enabled": true},
	"recordFieldNames": {"enabled": true, "config": {"naming": "PascalCase", "underscores": "None"}},
	"recursiveAsyncFunction": {"enabled": true},
	"redundantNewKeyword": {"enabled": true},
	"reimplementsFunction": {"enabled": true},
	"simpleAsyncComplementaryHelpers": {"enabled": true, "config": {"mode": "OnlyPublicAPIsInLibraries"}},
	"suggestUseAutoProperty": {"enabled": true},
	"synchronousFunctionNames": {"enabled": true},
	"trailingNewLineInFile": {"enabled": false},
	"trailingWhitespaceOnLine": {"enabled": true, "config": {"numberOfSpacesAllowed": 1, "oneSpaceAllowedAfterOperator": true, "ignoreBlankLines": true}},
	"tupleCommaSpacing": {"enabled": true},
	"tupleIndentation": {"enabled": true},
	"tupleOfWildcards": {"enabled": true},
	"tupleParentheses": {"enabled": true},
	"typedItemSpacing": {"enabled": true, "config": {"typedItemStyle": "SpaceAfter"}},
	"typeNames": {"enabled": true, "config": {"naming": "PascalCase", "underscores": "None"}},
	"typePrefixing": {"enabled": false},
	"unionCasesNames": {"enabled": true, "config": {"naming": "PascalCase", "underscores": "None"}},
	"unionDefinitionIndentation": {"enabled": true},
	"unneededRecKeyword": {"enabled": true},
	"unnestedFunctionNames": {"enabled": false},
	"usedUnderscorePrefixedElements": {"enabled": true},
	"uselessBinding": {"enabled": true},
	"wildcardNamedWithAsPattern": {"enabled": true},
	"hints": {
		"add": [
			"not (a =  b) ===> a <> b",
			"not (a <> b) ===> a =  b",
			"not (a >  b) ===> a <= b",
			"not (a >= b) ===> a <  b",
			"not (a <  b) ===> a >= b",
			"not (a <= b) ===> a >  b",
			"compare x y <> 1 ===> x <= y",
			"compare x y = -1 ===> x < y",
			"compare x y <> -1 ===> x >= y",
			"compare x y = 1 ===> x > y",
			"compare x y <= 0 ===> x <= y",
			"compare x y <  0 ===> x <  y",
			"compare x y >= 0 ===> x >= y",
			"compare x y >  0 ===> x >  y",
			"compare x y =  0 ===> x =  y",
			"compare x y <> 0 ===> x <> y",
			"List.head (List.sort x) ===> List.min x",
			"List.head (List.sortBy f x) ===> List.minBy f x",
			"List.map f (List.map g x) ===> List.map (g >> f) x",
			"Array.map f (Array.map g x) ===> Array.map (g >> f) x",
			"Seq.map f (Seq.map g x) ===> Seq.map (g >> f) x",
			"List.nth x 0 ===> List.head x",
			"List.map f (List.replicate n x) ===> List.replicate n (f x)",
			"List.rev (List.rev x) ===> x",
			"Array.rev (Array.rev x) ===> x",
			"List.fold (@) [] x ===> List.concat x",
			"List.map id x ===> id x",
			"Array.map id x ===> id x",
			"Seq.map id x ===> id x",
			"(List.length x) = 0 ===> List.isEmpty x",
			"(Array.length x) = 0 ===> Array.isEmpty x",
			"(Seq.length x) = 0 ===> Seq.isEmpty x",
			"x = [] ===> List.isEmpty x",
			"x = [||] ===> Array.isEmpty x",
			"(List.length x) <> 0 ===> not (List.isEmpty x)",
			"(Array.length x) <> 0 ===> not (Array.isEmpty x)",
			"(Seq.length x) <> 0 ===> not (Seq.isEmpty x)",
			"(List.length x) > 0 ===> not (List.isEmpty x)",
			"(Array.length x) <> 0 ===> not (Array.isEmpty x)",
			"(Seq.length x) <> 0 ===> not (Seq.isEmpty x)",
			"List.concat (List.map f x) ===> List.collect f x",
			"Array.concat (Array.map f x) ===> Array.collect f x",
			"Seq.concat (Seq.map f x) ===> Seq.collect f x",
			"List.isEmpty (List.filter f x) ===> not (List.exists f x)",
			"Array.isEmpty (Array.filter f x) ===> not (Array.exists f x)",
			"Seq.isEmpty (Seq.filter f x) ===> not (Seq.exists f x)",
			"not (List.isEmpty (List.filter f x)) ===> List.exists f x",
			"not (Array.isEmpty (Array.filter f x)) ===> Array.exists f x",
			"not (Seq.isEmpty (Seq.filter f x)) ===> Seq.exists f x",
			"List.length x >= 0 ===> true",
			"Array.length x >= 0 ===> true",
			"Seq.length x >= 0 ===> true",
			"x = true ===> x",
			"x = false ===> not x",
			"true = a ===> a",
			"false = a ===> not a",
			"a <> true ===> not a",
			"a <> false ===> a",
			"true <> a ===> not a",
			"false <> a ===> a",
			"if a then true else false ===> a",
			"if a then false else true ===> not a",
			"not (not x) ===> x",
			"(fst x, snd x) ===> x",
			"true && x ===> x",
			"false && x ===> false",
			"true || x ===> true",
			"false || x ===> x",
			"not true ===> false",
			"not false ===> true",
			"fst (x, y) ===> x",
			"snd (x, y) ===> y",
			"List.fold f x [] ===> x",
			"Array.fold f x [||] ===> x",
			"List.foldBack f [] x ===> x",
			"Array.foldBack f [||] x ===> x",
			"x - 0 ===> x",
			"x * 1 ===> x",
			"x / 1 ===> x",
			"List.fold (+) 0 x ===> List.sum x",
			"Array.fold (+) 0 x ===> Array.sum x",
			"Seq.fold (+) 0 x ===> Seq.sum x",
			"List.sum (List.map x y) ===> List.sumBy x y",
			"Array.sum (Array.map x y) ===> Array.sumBy x y",
			"Seq.sum (Seq.map x y) ===> Seq.sumBy x y",
			"List.average (List.map x y) ===> List.averageBy x y",
			"Array.average (Array.map x y) ===> Array.averageBy x y",
			"Seq.average (Seq.map x y) ===> Seq.averageBy x y",
			"(List.take x y, List.skip x y) ===> List.splitAt x y",
			"(Array.take x y, Array.skip x y) ===> Array.splitAt x y",
			"(Seq.take x y, Seq.skip x y) ===> Seq.splitAt x y",
			"List.empty ===> []",
			"Array.empty ===> [||]",
			"x::[] ===> [x]",
			"pattern: x::[] ===> [x]",
			"x @ [] ===> x",
			"(List.singleton x) @ y ===> x :: y",
			"List.isEmpty [] ===> true",
			"Array.isEmpty [||] ===> true",
			"fun _ -> () ===> ignore",
			"fun x -> x ===> id",
			"id x ===> x",
			"id >> f ===> f",
			"f >> id ===> f",
			"x = null ===> isNull x",
			"null = x ===> isNull x",
			"x <> null ===> not (isNull x)",
			"null <> x ===> not (isNull x)",
			"Array.append a (Array.append b c) ===> Array.concat [|a; b; c|]"
		]
	}
}
